# --- Supabase (required) -----------------------------------------------------
# Existing project credentials. The anon key is safe to ship to the browser;
# RLS is what protects the data.
VITE_SUPABASE_URL=https://eaddiwghkxsewueioqoy.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- AI tutor (server-side, NOT in this file) --------------------------------
# The model credential is deliberately absent here. It lives in the edge
# functions' environment, set with:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# See supabase/functions/tutor-reply/README.md. Never put a model API key in a
# VITE_ prefixed variable — Vite inlines those into the client bundle.

# --- Optional: client-side AI configuration ---------------------------------
# Time budget for a tutor reply before falling back to the rules engine.
# VITE_AI_TIMEOUT_MS=20000

# Alternative to the edge function: point at your own OpenAI-compatible
# gateway at <VITE_AI_PROXY_URL>/chat. The gateway must hold the credential
# itself and validate the Supabase bearer token.
# VITE_AI_PROXY_URL=https://api.example.com

# --- Optional: deploy the second edge function for AI-written lessons -------
# With `content-gen` deployed, today's lesson is written for the learner at
# their level. Without it, the curated lesson bank is used instead.
#   supabase functions deploy content-gen

# --- Optional: Web Push (background reminders) -----------------------------
# The PUBLIC half of a VAPID key pair — safe in the browser. The private half
# belongs in the edge function's environment. Generate a pair with:
#   npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# --- Optional: deployment helper -------------------------------------------
# A personal access token (https://supabase.com/dashboard/account/tokens) used
# only by scripts/deploy-migrations.mjs to apply the SQL migrations.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=eaddiwghkxsewueioqoy
